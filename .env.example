# ──────────────────────────────────────────────────────────────────────────────
# Velora API · variables de entorno
# Copia este archivo a `.env` (nunca lo subas al repositorio) o configúralas en
# el panel de Render / Vercel. Todas son opcionales: los valores por defecto
# permiten arrancar en local sin configuración.
# ──────────────────────────────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
# silent | error | warn | info | debug
LOG_LEVEL=debug

# ── CORS ──────────────────────────────────────────────────────────────────────
# Lista separada por comas. En producción, si se omite, no se permite ningún
# origen cruzado (la web se sirve desde el mismo dominio).
# Ejemplo: https://velora.vercel.app,https://mi-dominio.com
CORS_ORIGINS=

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_IMAGE_MAX=60
# Render/Vercel están detrás de un proxy: activa trust proxy para usar la IP real.
TRUST_PROXY=true

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Si se define, TODAS las rutas /api exigen la cabecera `X-API-Key`
# (excepto /api/health y /api/openapi.json). No la expongas en el frontend.
VELORA_API_KEY=
# Token opcional para elevar el límite de la API de GitHub en /api/search/github.
GITHUB_TOKEN=

# ── Red / proveedores externos ────────────────────────────────────────────────
# Timeout y tamaño máximo de las descargas externas.
HTTP_TIMEOUT_MS=9000
HTTP_MAX_BYTES=8388608
HTTP_MAX_REDIRECTS=3
# Permite apuntar a hosts privados (SOLO para pruebas locales con mocks).
ALLOW_PRIVATE_TARGETS=false
ALLOWED_PRIVATE_HOSTS=

# Sobrescribir las bases de los proveedores (útil para tests/mocks).
JIKAN_BASE_URL=https://api.jikan.moe/v4
OPENVERSE_BASE_URL=https://api.openverse.org/v1
LRCLIB_BASE_URL=https://lrclib.net/api
WIKIPEDIA_BASE_URL=https://{lang}.wikipedia.org/w/api.php
GITHUB_API_BASE_URL=https://api.github.com
OPENLIBRARY_BASE_URL=https://openlibrary.org
ITUNES_BASE_URL=https://itunes.apple.com
HN_BASE_URL=https://hn.algolia.com/api/v1
DUCKDUCKGO_BASE_URL=https://html.duckduckgo.com

# ── Subidas ───────────────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=8388608

# ── Caché en memoria ──────────────────────────────────────────────────────────
CACHE_PROVIDER_TTL_MS=300000
CACHE_MAX_ENTRIES=500

# ── Rutas / frontend ──────────────────────────────────────────────────────────
# El backend sirve la web compilada si existe (modo Render de un solo servicio).
SERVE_FRONTEND=true
# FRONTEND_DIR=/ruta/a/packages/frontend/dist
# ASSETS_DIR=/ruta/a/packages/backend/assets

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Solo necesaria si el frontend se despliega separado de la API (Vercel).
# En local, Vite hace proxy de /api hacia VITE_API_TARGET.
# VITE_API_URL=https://tu-api.onrender.com
# VITE_API_TARGET=http://127.0.0.1:4000

# ── Documentación estática ────────────────────────────────────────────────────
# Servidor que se escribe en docs/openapi*.json al ejecutar `npm run openapi`.
OPENAPI_SERVER_URL=http://localhost:4000
