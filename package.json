{
  "name": "velora-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Velora API — plataforma de catálogo, documentación y pruebas de una API REST real (Anime, Canvas, Download, Search y Utilidades).",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @velora/backend",
    "dev:web": "npm run dev -w @velora/frontend",
    "build": "npm run build -w @velora/backend && npm run build -w @velora/frontend",
    "build:api": "npm run build -w @velora/backend",
    "build:web": "npm run build -w @velora/frontend",
    "build:vercel": "npm run build:web",
    "start": "npm run start -w @velora/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @velora/backend && npm run test -w @velora/frontend",
    "test:api": "npm run test -w @velora/backend",
    "test:web": "npm run test -w @velora/frontend",
    "openapi": "npm run openapi -w @velora/backend",
    "smoke": "npm run smoke -w @velora/backend",
    "templates": "npm run templates -w @velora/backend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
