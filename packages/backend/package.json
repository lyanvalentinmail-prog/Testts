{
  "name": "@velora/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de Velora: canvas con plantillas reales, anime, búsquedas, descargas y utilidades.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/dev.ts",
    "build": "node scripts/build.mjs",
    "build:vercel": "node scripts/build.mjs --vercel",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "openapi": "tsx scripts/openapi.ts",
    "templates": "tsx scripts/templates.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@velora/shared": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
